
#include <stdio.h>
#include <string.h>

#define MAX_BOOKS 100

struct Book
{
    int id;
    char title[50];
    char department[20];
};

struct Book books[MAX_BOOKS] =
{
    {101, "Engineering Mathematics", "Maths"},
    {102, "Calculus", "Maths"},
    {103, "Linear Algebra", "Maths"},

    {201, "Applied Physics", "Physics"},
    {202, "Optics", "Physics"},
    {203, "Thermodynamics", "Physics"},

    {301, "Organic Chemistry", "Chemistry"},
    {302, "Inorganic Chemistry", "Chemistry"},
    {303, "Physical Chemistry", "Chemistry"}
};

int bookCount = 9;

// Display books based on department
void displayBooks(char department[])
{
    int i;

    printf("\n----- Available Books -----\n");

    for (i = 0; i < bookCount; i++)
    {
        if (strcmp(department, "Admin") == 0 ||
            strcmp(books[i].department, department) == 0)
        {
            printf("%d - %s (%s)\n",
                   books[i].id,
                   books[i].title,
                   books[i].department);
        }
    }
}

// Admin can add books
void addBook()
{
    if (bookCount >= MAX_BOOKS)
    {
        printf("Library is full!\n");
        return;
    }

    printf("Enter book ID: ");
    scanf("%d", &books[bookCount].id);

    printf("Enter book name: ");
    scanf(" %[^\n]", books[bookCount].title);

    printf("Enter department (Maths/Physics/Chemistry): ");
    scanf("%19s", books[bookCount].department);

    bookCount++;

    printf("Book added successfully!\n");
}

int main()
{
    char username[30];
    char password[30];
    char department[20];

    int choice;

    printf("===== LIBRARY MANAGEMENT SYSTEM =====\n");

    printf("Enter username: ");
    scanf("%29s", username);

    printf("Enter password: ");
    scanf("%29s", password);

    // Admin login
    if (strcmp(username, "admin") == 0 &&
        strcmp(password, "admin123") == 0)
    {
        strcpy(department, "Admin");

        printf("\nAdmin login successful!\n");

        while (1)
        {
            printf("\n1. View All Books\n");
            printf("2. Add Book\n");
            printf("3. Exit\n");

            printf("Enter choice: ");
            scanf("%d", &choice);

            switch (choice)
            {
                case 1:
                    displayBooks(department);
                    break;

                case 2:
                    addBook();
                    break;

                case 3:
                    printf("Admin logged out.\n");
                    return 0;

                default:
                    printf("Invalid choice!\n");
            }
        }
    }

    // Maths student login
    else if (strcmp(username, "maths") == 0 &&
             strcmp(password, "12345") == 0)
    {
        strcpy(department, "Maths");
    }

    // Physics student login
    else if (strcmp(username, "physics") == 0 &&
             strcmp(password, "12345") == 0)
    {
        strcpy(department, "Physics");
    }

    // Chemistry student login
    else if (strcmp(username, "chemistry") == 0 &&
             strcmp(password, "12345") == 0)
    {
        strcpy(department, "Chemistry");
    }

    // Invalid login
    else
    {
        printf("\nInvalid username or password!\n");
        return 0;
    }

    // Student menu
    printf("\nWelcome to %s Department Library!\n", department);

    while (1)
    {
        printf("\n1. View Books\n");
        printf("2. Exit\n");

        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                displayBooks(department);
                break;

            case 2:
                printf("Student logged out.\n");
                return 0;

            default:
                printf("Invalid choice!\n");
        }
    }

    return 0;
}
